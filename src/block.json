{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-bootstrap-carousel/carousel",
  "version": "1.0.0",
  "title": "Bootstrap Carousel",
  "category": "media",
  "icon": "images-alt2",
  "description": "Add a modern, fully responsive Bootstrap 5 carousel slider with custom images, captions, and buttons.",
  "keywords": [
    "carousel",
    "slider",
    "bootstrap",
    "gallery",
    "slideshow"
  ],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "slides": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "interval": {
      "type": "number",
      "default": 5000
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
    },
    "fadeTransition": {
      "type": "boolean",
      "default": false
    },
    "showControls": {
      "type": "boolean",
      "default": true
    },
    "showIndicators": {
      "type": "boolean",
      "default": true
    },
    "darkVariant": {
      "type": "boolean",
      "default": false
    },
    "aspectRatio": {
      "type": "string",
      "default": "16-9"
    },
    "customHeight": {
      "type": "string",
      "default": "500px"
    },
    "keyboardNavigation": {
      "type": "boolean",
      "default": true
    },
    "touchSwipe": {
      "type": "boolean",
      "default": true
    },
    "uniqueId": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "wordpress-plugin-gutenberg-block-bootstrap-carousel",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
